{
  "expo": {
    "name": "KLENTEC BMS",
    "slug": "klentec-bms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F6FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klentec.bms"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4F8A"
      },
      "package": "com.klentec.bms",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "763a3ef2-d015-4e3e-9d27-107d335a5e15"
      }
    },
    "owner": "udaysingh3204"
  }
}
